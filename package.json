{
  "name": "vocoso",
  "version": "0.1.0",
  "description": "Catches AI-generated UI that retypes your data instead of binding to it. Plus self-driving voice and chat conversation tests with no human oracle.",
  "keywords": [
    "generative-ui",
    "ai-generated-ui",
    "grounding",
    "hallucination",
    "llm-testing",
    "ag-ui",
    "a2ui",
    "voice-ai",
    "realtime",
    "conversational-ai",
    "evals",
    "playwright",
    "webrtc",
    "self-healing",
    "qa"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "vocoso": "bin/vocoso.mjs"
  },
  "main": "src/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./presets": "./src/transport/presets.mjs",
    "./package.json": "./package.json",
    "./assert": {
      "types": "./types/assert.d.ts",
      "import": "./src/assert.mjs"
    }
  },
  "files": [
    "bin",
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "node --check bin/vocoso.mjs && node scripts/syntax-check.mjs",
    "selftest": "node bin/vocoso.mjs doctor"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BusyBee3333/vocoso.git"
  },
  "bugs": {
    "url": "https://github.com/BusyBee3333/vocoso/issues"
  },
  "homepage": "https://github.com/BusyBee3333/vocoso#readme",
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
